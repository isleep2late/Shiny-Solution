<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ShinySolution.Core</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <!-- The Gen 1 Trainer ID tables / methodologies and the Gen 3 Secret ID models, generated by
         tools/gen-gen1-data.py from RNG Solution's registry. Gen1TidData.Load() prefers a copy
         beside the executable and falls back to these embedded copies. -->
    <EmbeddedResource Include="../../core/data/gen1-tid.json" LogicalName="data.gen1-tid" />
    <EmbeddedResource Include="../../core/data/gen3-sid.json" LogicalName="data.gen3-sid" />
    <!-- The Gen 2 Trainer ID / Lucky ID tables (Gold / Silver / Crystal, every platform and RTC state), generated by
         tools/gen-gen2-data.py from the derivation folder. Gen2TidData.Load() prefers a copy beside the executable. -->
    <EmbeddedResource Include="../../core/data/gen2-tid.json" LogicalName="data.gen2-tid" />
    <!-- The Gen 3 / Gen 4 species tables, wild encounter tables and static / gift catalogue (tools/gen-guide-data.py,
         docs/DATA.md), read by the desktop wizard panel (app/App/WizardSupport.cs: WizardData.Load prefers a copy of
         the three files of a generation beside the executable and falls back to these). -->
    <EmbeddedResource Include="../../core/data/species-gen3.json" LogicalName="data.species-gen3" />
    <EmbeddedResource Include="../../core/data/encounters-gen3.json" LogicalName="data.encounters-gen3" />
    <EmbeddedResource Include="../../core/data/statics-gen3.json" LogicalName="data.statics-gen3" />
    <EmbeddedResource Include="../../core/data/species-gen4.json" LogicalName="data.species-gen4" />
    <EmbeddedResource Include="../../core/data/encounters-gen4.json" LogicalName="data.encounters-gen4" />
    <EmbeddedResource Include="../../core/data/statics-gen4.json" LogicalName="data.statics-gen4" />
    <!-- The decomp citation registry generated from docs/FACTS.md by tools/gen-citations.py: the desktop wizard panel's
         procedure footnotes are rendered over it (Wizard.LoadCitations prefers citations.json beside the executable). -->
    <EmbeddedResource Include="../../core/data/citations.json" LogicalName="data.citations" />
  </ItemGroup>
</Project>
