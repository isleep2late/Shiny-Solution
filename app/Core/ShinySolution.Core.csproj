<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ShinySolution.Core</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <!-- The Gen 1 Trainer ID tables / methodologies and the Gen 3 Secret ID models, generated by
         tools/gen-gen1-data.py from RNG Solution's registry. Gen1TidData.Load() prefers a copy
         beside the executable and falls back to these embedded copies. -->
    <EmbeddedResource Include="../../core/data/gen1-tid.json" LogicalName="data.gen1-tid" />
    <EmbeddedResource Include="../../core/data/gen3-sid.json" LogicalName="data.gen3-sid" />
    <!-- The Gen 2 Trainer ID / Lucky ID tables (Gold / Silver / Crystal, every platform and RTC state), generated by
         tools/gen-gen2-data.py from the derivation folder. Gen2TidData.Load() prefers a copy beside the executable. -->
    <EmbeddedResource Include="../../core/data/gen2-tid.json" LogicalName="data.gen2-tid" />
  </ItemGroup>
</Project>
